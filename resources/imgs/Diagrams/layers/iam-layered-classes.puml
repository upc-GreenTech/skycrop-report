@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 120
scale max 2800 width
hide empty members
top to bottom direction
title SkyCrop - IAM — Identity and Access Management - Layered Class Design
package "Interfaces / Presentation" {
class AccountController <<controller>> {
-service: IAccountApplicationService
+authenticate(request: AuthenticateRequest): AccessTokenResource
}
class AuthenticateRequest <<request>> {
-username: String
-password: String
}
class AccessTokenResource <<resource>> {
-token: String
-expiresAt: Timestamp
}
class AccessTokenIssuer <<token issuer>> {
+issue(accountId: Long): AccessTokenResource
}
}
package "Application" {
class AuthenticateCommand <<command>> {
-username: String
-password: String
}
interface IAccountApplicationService {
+authenticate(command: AuthenticateCommand): AccessTokenResource
}
class AccountApplicationService <<application service>> {
-repository: IAccountRepository
+authenticate(command: AuthenticateCommand): AccessTokenResource
}
}
package "Domain" {
class Account <<aggregate root>> {
-id: Long
-username: String
-passwordHash: String
-status: AccountStatus
+authenticate(): boolean
}
interface IAccountRepository <<repository contract>> {
+findByUsername(username: String): Account [0..1]
+save(entity: Account): void
}
}
package "Infrastructure" {
class AccountRepository <<repository>> {
-dbContext: SkyCropDbContext
+findByUsername(username: String): Account [0..1]
+save(entity: Account): void
}
class SkyCropDbContext <<EF Core>> {
+saveChanges(): int
}
}
AccountController --> IAccountApplicationService : delegates
AccountController ..> AuthenticateRequest : receives
AccountController ..> AuthenticateCommand : builds
AccountController ..> AccessTokenResource : responds
AccountApplicationService ..|> IAccountApplicationService
IAccountApplicationService ..> AuthenticateCommand : receives
AccountApplicationService --> IAccountRepository : queries and persists
AccountApplicationService ..> Account : executes operations
AccountApplicationService ..> AccessTokenIssuer : transforms
AccessTokenIssuer ..> AccessTokenResource : produces
AccountRepository ..|> IAccountRepository
IAccountRepository ..> Account : persistence contract
AccountRepository --> SkyCropDbContext : data access
package "Application" {
interface ICredentialVerifier <<integration contract>> {
+verify(password: String, passwordHash: String): boolean
}
}
package "Infrastructure" {
class PasswordHashVerifier <<adapter>> {
+verify(password: String, passwordHash: String): boolean
}
}
AccountApplicationService --> ICredentialVerifier : requests an operation
PasswordHashVerifier ..|> ICredentialVerifier
note bottom of PasswordHashVerifier
Verifies credentials without returning the password or its hash.
end note
AccountController -[hidden]down-> AccountApplicationService
AccountApplicationService -[hidden]down-> Account
Account -[hidden]down-> AccountRepository
legend bottom
Proposed class architecture for the backend RESTful API.
The view shows a context use case and credential verification.
Aggregate attributes are detailed in the domain views.
Infrastructure dependencies implement internal contracts.
endlegend
@enduml
