@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 120
scale max 2800 width
hide empty members
top to bottom direction
title SkyCrop - Drone Management - Layered Class Design
package "Interfaces / Presentation" {
class DroneController <<controller>> {
-service: IDroneApplicationService
+register(request: RegisterDroneRequest): DroneResource
+getById(id: Long): DroneResource
}
class RegisterDroneRequest <<request>> {
-ownerId: Long
-serialNumber: String
-model: String
}
class DroneResource <<resource>> {
-id: Long
}
class DroneResourceAssembler <<assembler>> {
+toResource(entity: Drone): DroneResource
}
}
package "Application" {
class RegisterDroneCommand <<command>> {
-ownerId: Long
-serialNumber: String
-model: String
}
interface IDroneApplicationService {
+register(command: RegisterDroneCommand): DroneResource
+getById(id: Long): DroneResource
}
class DroneApplicationService <<application service>> {
-repository: IDroneRepository
+register(command: RegisterDroneCommand): DroneResource
+getById(id: Long): DroneResource
}
}
package "Domain" {
class Drone <<aggregate root>> {
-id: Long
-serialNumber: DroneSerialNumber
-status: DroneStatus
+configure(): void
}
interface IDroneRepository <<repository contract>> {
+findById(id: Long): Drone [0..1]
+save(entity: Drone): void
}
}
package "Infrastructure" {
class DroneRepository <<repository>> {
-dbContext: SkyCropDbContext
+findById(id: Long): Drone [0..1]
+save(entity: Drone): void
}
class SkyCropDbContext <<EF Core>> {
+saveChanges(): int
}
}
DroneController --> IDroneApplicationService : delegates
DroneController ..> RegisterDroneRequest : receives
DroneController ..> RegisterDroneCommand : builds
DroneController ..> DroneResource : responds
DroneApplicationService ..|> IDroneApplicationService
IDroneApplicationService ..> RegisterDroneCommand : receives
DroneApplicationService --> IDroneRepository : queries and persists
DroneApplicationService ..> Drone : executes operations
DroneApplicationService ..> DroneResourceAssembler : transforms
DroneResourceAssembler ..> Drone : reads
DroneResourceAssembler ..> DroneResource : produces
DroneRepository ..|> IDroneRepository
IDroneRepository ..> Drone : persistence contract
DroneRepository --> SkyCropDbContext : data access
package "Application" {
interface IDroneGateway <<integration contract>> {
+connect(droneId: Long): boolean
}
}
package "Infrastructure" {
class DroneGatewayAdapter <<adapter>> {
+connect(droneId: Long): boolean
}
}
DroneApplicationService --> IDroneGateway : requests an operation
DroneGatewayAdapter ..|> IDroneGateway
note bottom of DroneGatewayAdapter
Encapsulates communication with the registered device.
end note
DroneController -[hidden]down-> DroneApplicationService
DroneApplicationService -[hidden]down-> Drone
Drone -[hidden]down-> DroneRepository
legend bottom
Proposed class architecture for the backend RESTful API.
The view shows a context use case and retrieval by identifier.
Aggregate attributes are detailed in the domain views.
Infrastructure dependencies implement internal contracts.
endlegend
package "Domain" {
class DroneSerialNumber <<value object>> {
-value: String {readOnly}
}
note right of DroneSerialNumber
Non-empty text after trimming outer whitespace.
Preserves case; equality compares the stored value.
Uniqueness is checked by the registration use case.
end note
}
Drone "1" *-- "1" DroneSerialNumber : serialNumber
note right of RegisterDroneCommand
The application service creates a validated DroneSerialNumber
before assigning the serial number to the aggregate.
Invalid input must not be persisted.
end note
@enduml
