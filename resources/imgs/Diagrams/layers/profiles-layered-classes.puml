@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 120
hide empty members
top to bottom direction
title SkyCrop - Profiles and Preferences Management - Diseño por capas
package "Interfaces / Presentation" {
class UserProfileController <<controller>> {
-service: IUserProfileApplicationService
+update(request: UpdateProfileRequest): UserProfileResource
+getById(id: Long): UserProfileResource
}
class UpdateProfileRequest <<request>> {
-userId: Long
-phone: String [0..1]
-address: String [0..1]
}
class UserProfileResource <<resource>> {
-id: Long
}
class UserProfileResourceAssembler <<assembler>> {
+toResource(entity: UserProfile): UserProfileResource
}
}
package "Application" {
class UpdateProfileCommand <<command>> {
-userId: Long
-phone: String [0..1]
-address: String [0..1]
}
interface IUserProfileApplicationService {
+update(command: UpdateProfileCommand): UserProfileResource
+getById(id: Long): UserProfileResource
}
class UserProfileApplicationService <<application service>> {
-repository: IUserProfileRepository
+update(command: UpdateProfileCommand): UserProfileResource
+getById(id: Long): UserProfileResource
}
}
package "Domain" {
class UserProfile <<aggregate root>> {
-id: Long
-phone: PhoneNumber [0..1]
-address: PostalAddress [0..1]
+updateInformation(): void
}
interface IUserProfileRepository <<repository contract>> {
+findById(id: Long): UserProfile [0..1]
+save(entity: UserProfile): void
}
}
package "Infrastructure" {
class UserProfileRepository <<repository>> {
-dbContext: SkyCropDbContext
+findById(id: Long): UserProfile [0..1]
+save(entity: UserProfile): void
}
class SkyCropDbContext <<EF Core>> {
+saveChanges(): int
}
}
UserProfileController --> IUserProfileApplicationService : delega
UserProfileController ..> UpdateProfileRequest : recibe
UserProfileController ..> UpdateProfileCommand : construye
UserProfileController ..> UserProfileResource : responde
UserProfileApplicationService ..|> IUserProfileApplicationService
IUserProfileApplicationService ..> UpdateProfileCommand : recibe
UserProfileApplicationService --> IUserProfileRepository : consulta y persiste
UserProfileApplicationService ..> UserProfile : ejecuta operaciones
UserProfileApplicationService ..> UserProfileResourceAssembler : transforma
UserProfileResourceAssembler ..> UserProfile : lee
UserProfileResourceAssembler ..> UserProfileResource : produce
UserProfileRepository ..|> IUserProfileRepository
IUserProfileRepository ..> UserProfile : contrato de persistencia
UserProfileRepository --> SkyCropDbContext : acceso a datos
UserProfileController -[hidden]down-> UserProfileApplicationService
UserProfileApplicationService -[hidden]down-> UserProfile
UserProfile -[hidden]down-> UserProfileRepository
legend bottom
Arquitectura de clases propuesta para el backend RESTful API.
La vista muestra un caso de uso del contexto y su consulta por identidad.
Los atributos del agregado se detallan en las vistas del dominio.
Las dependencias de infraestructura implementan contratos internos.
endlegend
@enduml
