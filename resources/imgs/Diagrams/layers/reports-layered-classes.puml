@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 120
hide empty members
top to bottom direction
title SkyCrop - Report Management - Diseño por capas
package "Interfaces / Presentation" {
class ReportController <<controller>> {
-service: IReportApplicationService
+generate(request: GenerateReportRequest): ReportResource
+getById(id: Long): ReportResource
}
class GenerateReportRequest <<request>> {
-plotId: Long
-diagnosisIds: List<Long>
}
class ReportResource <<resource>> {
-id: Long
}
class ReportResourceAssembler <<assembler>> {
+toResource(entity: Report): ReportResource
}
}
package "Application" {
class GenerateReportCommand <<command>> {
-plotId: Long
-diagnosisIds: List<Long>
}
interface IReportApplicationService {
+generate(command: GenerateReportCommand): ReportResource
+getById(id: Long): ReportResource
}
class ReportApplicationService <<application service>> {
-repository: IReportRepository
+generate(command: GenerateReportCommand): ReportResource
+getById(id: Long): ReportResource
}
}
package "Domain" {
class Report <<aggregate root>> {
-id: Long
-title: String
-type: ReportType
+export(): void
}
interface IReportRepository <<repository contract>> {
+findById(id: Long): Report [0..1]
+save(entity: Report): void
}
}
package "Infrastructure" {
class ReportRepository <<repository>> {
-dbContext: SkyCropDbContext
+findById(id: Long): Report [0..1]
+save(entity: Report): void
}
class SkyCropDbContext <<EF Core>> {
+saveChanges(): int
}
}
ReportController --> IReportApplicationService : delega
ReportController ..> GenerateReportRequest : recibe
ReportController ..> GenerateReportCommand : construye
ReportController ..> ReportResource : responde
ReportApplicationService ..|> IReportApplicationService
IReportApplicationService ..> GenerateReportCommand : recibe
ReportApplicationService --> IReportRepository : consulta y persiste
ReportApplicationService ..> Report : ejecuta operaciones
ReportApplicationService ..> ReportResourceAssembler : transforma
ReportResourceAssembler ..> Report : lee
ReportResourceAssembler ..> ReportResource : produce
ReportRepository ..|> IReportRepository
IReportRepository ..> Report : contrato de persistencia
ReportRepository --> SkyCropDbContext : acceso a datos
package "Application" {
interface IReportStorage <<integration contract>> {
+save(reportId: Long, content: String): String
}
}
package "Infrastructure" {
class CloudReportStorage <<adapter>> {
+save(reportId: Long, content: String): String
}
}
ReportApplicationService --> IReportStorage : solicita operación
CloudReportStorage ..|> IReportStorage
note bottom of CloudReportStorage
Almacena el archivo del reporte y devuelve su ubicación.
end note
ReportController -[hidden]down-> ReportApplicationService
ReportApplicationService -[hidden]down-> Report
Report -[hidden]down-> ReportRepository
legend bottom
Arquitectura de clases propuesta para el backend RESTful API.
La vista muestra un caso de uso del contexto y su consulta por identidad.
Los atributos del agregado se detallan en las vistas del dominio.
Las dependencias de infraestructura implementan contratos internos.
endlegend
@enduml
