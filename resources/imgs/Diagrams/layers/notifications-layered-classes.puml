@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 120
hide empty members
top to bottom direction
title SkyCrop - Notification Service - Diseño por capas
package "Interfaces / Presentation" {
class NotificationController <<controller>> {
-service: INotificationApplicationService
+send(request: SendNotificationRequest): NotificationResource
+getById(id: Long): NotificationResource
}
class SendNotificationRequest <<request>> {
-recipientId: Long
-message: String
-diagnosisId: Long [0..1]
-anomalyId: Long [0..1]
}
class NotificationResource <<resource>> {
-id: Long
}
class NotificationResourceAssembler <<assembler>> {
+toResource(entity: Notification): NotificationResource
}
}
package "Application" {
class SendNotificationCommand <<command>> {
-recipientId: Long
-message: String
-diagnosisId: Long [0..1]
-anomalyId: Long [0..1]
}
interface INotificationApplicationService {
+send(command: SendNotificationCommand): NotificationResource
+getById(id: Long): NotificationResource
}
class NotificationApplicationService <<application service>> {
-repository: INotificationRepository
+send(command: SendNotificationCommand): NotificationResource
+getById(id: Long): NotificationResource
}
}
package "Domain" {
class Notification <<aggregate root>> {
-id: Long
-message: String
-status: NotificationStatus
+markAsRead(): void
}
interface INotificationRepository <<repository contract>> {
+findById(id: Long): Notification [0..1]
+save(entity: Notification): void
}
}
package "Infrastructure" {
class NotificationRepository <<repository>> {
-dbContext: SkyCropDbContext
+findById(id: Long): Notification [0..1]
+save(entity: Notification): void
}
class SkyCropDbContext <<EF Core>> {
+saveChanges(): int
}
}
NotificationController --> INotificationApplicationService : delega
NotificationController ..> SendNotificationRequest : recibe
NotificationController ..> SendNotificationCommand : construye
NotificationController ..> NotificationResource : responde
NotificationApplicationService ..|> INotificationApplicationService
INotificationApplicationService ..> SendNotificationCommand : recibe
NotificationApplicationService --> INotificationRepository : consulta y persiste
NotificationApplicationService ..> Notification : ejecuta operaciones
NotificationApplicationService ..> NotificationResourceAssembler : transforma
NotificationResourceAssembler ..> Notification : lee
NotificationResourceAssembler ..> NotificationResource : produce
NotificationRepository ..|> INotificationRepository
INotificationRepository ..> Notification : contrato de persistencia
NotificationRepository --> SkyCropDbContext : acceso a datos
package "Application" {
interface INotificationDelivery <<integration contract>> {
+send(recipientId: Long, message: String): boolean
}
}
package "Infrastructure" {
class MessageDeliveryAdapter <<adapter>> {
+send(recipientId: Long, message: String): boolean
}
}
NotificationApplicationService --> INotificationDelivery : solicita operación
MessageDeliveryAdapter ..|> INotificationDelivery
note bottom of MessageDeliveryAdapter
Entrega el aviso mediante el canal del destinatario.
end note
NotificationController -[hidden]down-> NotificationApplicationService
NotificationApplicationService -[hidden]down-> Notification
Notification -[hidden]down-> NotificationRepository
legend bottom
Arquitectura de clases propuesta para el backend RESTful API.
La vista muestra un caso de uso del contexto y su consulta por identidad.
Los atributos del agregado se detallan en las vistas del dominio.
Las dependencias de infraestructura implementan contratos internos.
endlegend
@enduml
