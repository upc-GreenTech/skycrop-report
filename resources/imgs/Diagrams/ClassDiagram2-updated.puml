@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 150
hide empty members
legend bottom
aggregate root: acceso a las entidades del agregado.
external reference: identidad de un objeto de otro contexto.
Las dependencias rotuladas con Id representan referencias por identificador.
Todos los value objects carecen de identidad y son inmutables.
Se validan al construirlos; una modificación crea un nuevo valor.
La igualdad compara sus atributos, salvo Timestamp (instante UTC).
CalendarDate representa una fecha válida sin hora ni zona horaria.
endlegend
title SkyCrop - Gestión de Parcelas y Drones
class User <<external reference>> {
-id: Long
}
class AgriculturalPlot <<aggregate root>> {
-ownerId: Long
-memberIds: Set<Long>
-id: Long
-name: Name
-areaHectares: Area
-location: Location
-createdAt: Timestamp
-status: PlotStatus
+register(): void
+updateInformation(): void
+defineLimits(): void
+generateMap(): PlotMap
+updateDashboard(): void
}
interface MapService  {

+getLocationInformation(): Location
+generatePlotMap(plot: AgriculturalPlot): PlotMap
}
class Crop  {
-id: Long
-name: Name
-variety: String
-growthStage: String
-registrationDate: CalendarDate
+register(): void
+updateInformation(): void
+assignToPlot(plotId: Long): void
}
class PlotMap  {
-id: Long
-mapUrl: String
-generatedAt: Timestamp
-source: String
+generate(): void
+display(): void
+update(): void
}
class FlightPlan <<aggregate root>> {
-plotId: Long
-id: Long
-name: Name
-altitude: Decimal
-speed: Decimal
-overlap: Decimal
-status: FlightPlanStatus
+createRoute(): void
+customizeRoute(): void
+validateRoute(): boolean
}
class Drone <<aggregate root>> {
-ownerId: Long
-id: Long
-serialNumber: String
-model: String
-batteryLevel: Decimal
-range: Decimal
-status: DroneStatus
+register(): void
+configure(): void
+checkBattery(): Decimal
+startFlight(): void
+stopFlight(): void
}
interface DroneController  {

+connect(drone: Drone): boolean
+configure(drone: Drone): void
+uploadFlightPlan(plan: FlightPlan): void
+startFlight(flight: Flight): void
+stopFlight(flight: Flight): void
}
class DroneConfiguration  {
-id: Long
-connectionSettings: String
-flightSettings: String
-securitySettings: String
+configure(): void
+updateSettings(): void
+applyToDrone(droneId: Long): void
}
class Flight <<aggregate root>> {
-flightPlanId: Long
-droneId: Long
-id: Long
-startTime: Timestamp [0..1]
-endTime: Timestamp [0..1]
-status: FlightStatus
+start(): void
+pause(): void
+finish(): void
+cancel(): void
+captureImage(): AerialImage
}
class AerialImage  {
-id: Long
-capturedAt: Timestamp
-resolution: String
-fileUrl: String
-quality: ImageQuality
+capture(): void
+upload(): void
+validateQuality(): boolean
}
interface CloudStorageService  {

+upload(file: AerialImage): String
+download(url: String): AerialImage
}
enum PlotStatus {
ACTIVE
INACTIVE
}
enum FlightPlanStatus {
DRAFT
READY
ACTIVE
COMPLETED
}
enum DroneStatus {
AVAILABLE
IN_FLIGHT
LOW_BATTERY
OFFLINE
MAINTENANCE
}
enum FlightStatus {
PLANNED
IN_PROGRESS
PAUSED
COMPLETED
CANCELLED
}
enum ImageQuality {
LOW
MEDIUM
HIGH
}
class Location <<value object>> {
-value: String {readOnly}

}
class Area <<value object>> {
-value: Decimal {readOnly}
-unit: String = "ha" {readOnly}

}
AgriculturalPlot ..> User : ownerId / memberIds
Drone ..> User : ownerId
AgriculturalPlot "1" *-- "1" Area : areaHectares
AgriculturalPlot "1" *-- "1" Location : location
AgriculturalPlot --> PlotStatus : status
AgriculturalPlot "1" *-- "0..*" Crop : contains
AgriculturalPlot "1" *-- "0..1" PlotMap : has
FlightPlan ..> AgriculturalPlot : plotId
MapService ..> AgriculturalPlot : obtains location
MapService ..> PlotMap : generates
MapService ..> Location
FlightPlan --> FlightPlanStatus : status
Flight ..> FlightPlan : flightPlanId
Flight ..> Drone : droneId
Drone "1" *-- "1" DroneConfiguration : uses
Drone --> DroneStatus : status
DroneController ..> FlightPlan : uploads
DroneController ..> Flight : controls
DroneController ..> Drone : controls
DroneController ..> DroneConfiguration : configures
Flight --> FlightStatus : status
Flight "1" *-- "0..*" AerialImage : captures
CloudStorageService ..> AerialImage : stores
AerialImage --> ImageQuality : quality
note bottom of Area
Inmutable; unidad fija en hectáreas.
Igualdad por sus valores, sin identidad.
end note
class Name <<value object>> {
-value: String {readOnly}
}
note right of Name
Texto no vacío después de quitar espacios externos.
Conserva caracteres y escritura del nombre.
Sin exigir cantidad de palabras.
end note
class Timestamp <<value object>> {
-value: DateTimeOffset {readOnly}
}
note right of Timestamp
Instante válido con desplazamiento horario.
Igualdad y comparación por instante UTC.
end note
AgriculturalPlot "1" *-- "1" Name : name
Crop "1" *-- "1" Name : name
FlightPlan "1" *-- "1" Name : name
AgriculturalPlot ..> Timestamp : temporal values
PlotMap ..> Timestamp : temporal values
Flight ..> Timestamp : temporal values
AerialImage ..> Timestamp : temporal values
class CalendarDate <<value object>> {
-value: Date {readOnly}
}
Crop "1" *-- "1" CalendarDate : registrationDate
note bottom of Flight
startTime está ausente antes del inicio.
endTime está ausente antes del fin del vuelo.
Cuando ambos existen, endTime >= startTime.
end note
@enduml
