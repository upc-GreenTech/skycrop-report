@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Vista general de componentes del frontend
actor "Agricultor / Ingeniero agrónomo\n[Persona]" as user
rectangle "Frontend Web Application\n[Contenedor: Vue / JavaScript / PrimeVue]" {
component "Layout y navegación\n[Componente: Vue]\n\nNavegación entre vistas, idioma y estados de interfaz." as layout
component "Diagnoses Generation / Core\n[Componente: Vue / JavaScript]\n\nDiagnósticos, mapa de resultados e historial." as diagnoses
component "Report Management / Core\n[Componente: Vue / JavaScript]\n\nReportes, comparación y descarga de documentos." as reports
component "Agricultural Plot Management / Soporte\n[Componente: Vue / JavaScript]\n\nRegistro, detalles, cultivos y colaboración en parcelas." as plots
component "Drone Management / Soporte\n[Componente: Vue / JavaScript]\n\nRegistro de drones, configuración y vuelos." as drones
component "Subscriptions and Payment Management / Soporte\n[Componente: Vue / JavaScript]\n\nPlanes, pagos y estado de suscripción." as subscriptions
component "Profiles and Preferences Management / Soporte\n[Componente: Vue / JavaScript]\n\nConsulta y edición de datos del perfil." as profiles
component "Notification Service / Genérico\n[Componente: Vue / JavaScript]\n\nAvisos, detalle y estado de lectura." as notifications
component "IAM — Identity and Access Management / Genérico\n[Componente: Vue / JavaScript]\n\nRegistro, inicio de sesión y recuperación de acceso." as iam
component "Cliente HTTP\n[Componente: JavaScript]\n\nSolicitudes REST y tratamiento de errores." as http
}
component "Backend RESTful API\n[Contenedor: C# / ASP.NET Core]\n\nOperaciones del dominio." as api
user --> layout : Interactúa
layout --> diagnoses : Navega
diagnoses --> http : Solicita operaciones
layout --> reports : Navega
reports --> http : Solicita operaciones
layout --> plots : Navega
plots --> http : Solicita operaciones
layout --> drones : Navega
drones --> http : Solicita operaciones
layout --> subscriptions : Navega
subscriptions --> http : Solicita operaciones
layout --> profiles : Navega
profiles --> http : Solicita operaciones
layout --> notifications : Navega
notifications --> http : Solicita operaciones
layout --> iam : Navega
iam --> http : Solicita operaciones
http --> api : REST [HTTPS / JSON]
legend bottom
C4 - Vista de componentes de la arquitectura propuesta.
Cada vista amplía un único contenedor.
Los contextos agrupan responsabilidades dentro del contenedor.
endlegend
@enduml
