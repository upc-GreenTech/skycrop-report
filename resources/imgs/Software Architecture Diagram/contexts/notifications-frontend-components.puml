@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Notification Service - frontend
actor "Agricultor / Ingeniero agrónomo\n[Persona]" as user
rectangle "Frontend Web Application\n[Contenedor: Vue / JavaScript / PrimeVue]" {
rectangle "Notification Service" {
component "notification-list\n[Componente: Vue / PrimeVue]\n\nAvisos, detalle y estado de lectura." as view0
component "notification-details\n[Componente: Vue / PrimeVue]\n\nInteracción y datos de la vista." as view1
component "Notification Store\n[Componente: Pinia / JavaScript]\n\nCoordina acciones, datos, carga y errores del contexto." as state
component "Notification API Client\n[Componente: JavaScript]\n\nExpone las operaciones remotas del contexto." as apiclient
component "Notification Assembler\n[Componente: JavaScript]\n\nTransforma recursos HTTP en modelos de la aplicación." as assembler
}
component "Cliente HTTP compartido\n[Componente: JavaScript]\n\nURL base y tratamiento de respuestas HTTP." as http
}
component "Backend RESTful API\n[Contenedor: C# / ASP.NET Core]\n\nExpone los contratos del contexto." as api
user --> view0 : Interactúa
view0 --> state : Consulta / solicita acciones
user --> view1 : Interactúa
view1 --> state : Consulta / solicita acciones
state --> apiclient : Invoca operaciones
apiclient --> assembler : Transforma respuestas
apiclient --> http : Envía solicitudes
http --> api : REST [HTTPS / JSON]
legend bottom
C4 - Vista de componentes de la arquitectura propuesta.
Cada vista amplía un único contenedor.
Los contextos agrupan responsabilidades dentro del contenedor.
endlegend
@enduml
