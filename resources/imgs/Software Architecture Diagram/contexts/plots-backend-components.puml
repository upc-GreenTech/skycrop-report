@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Agricultural Plot Management - backend
component "Frontend Web Application\n[Contenedor: Vue]\n\nSolicita operaciones del contexto." as web
rectangle "Backend RESTful API\n[Contenedor: C# / ASP.NET Core]" {
rectangle "Agricultural Plot Management" {
component "AgriculturalPlotController / Interfaces\n[Componente: ASP.NET Core]\n\nRecibe requests, construye comandos y devuelve recursos." as controller
component "AgriculturalPlotApplicationService / Application\n[Componente: C#]\n\nAdministra parcelas, cultivos y acceso colaborativo." as service
component "Modelo de dominio / Domain\n[Componente: C#]\n\nAgregados, entidades, objetos de valor y reglas del contexto." as domain
component "Repositorios / Infrastructure\n[Componente: Entity Framework Core]\n\nImplementan contratos de persistencia de los agregados." as repository
component "PlotMapAdapter / Infrastructure\n[Componente: C#]\n\nRepresentación geográfica." as adapter
}
}
database "Base de datos relacional\n[Contenedor: MySQL Server o PostgreSQL]" as db
web --> controller : REST [HTTPS / JSON]
controller --> service : Delega operaciones
service --> domain : Aplica reglas
service --> repository : Consulta y persiste
repository --> domain : Reconstruye agregados
repository --> db : Lectura y escritura [EF Core / SQL]
service --> adapter : Solicita operación
component "Servicio de mapas\n[Sistema externo: Servicio externo]\n\nRepresentación geográfica." as provider
adapter --> provider : HTTPS
legend bottom
C4 - Vista de componentes de la arquitectura propuesta.
Cada vista amplía un único contenedor.
Los contextos agrupan responsabilidades dentro del contenedor.
endlegend
@enduml
