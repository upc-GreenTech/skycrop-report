@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Vista general de componentes del backend
component "Frontend Web Application\n[Contenedor: Vue]\n\nConsume operaciones REST." as web
rectangle "Backend RESTful API\n[Contenedor: C# / ASP.NET Core]" {
component "Diagnoses Generation / Core\n[Componente: ASP.NET Core / C#]\n\nSolicita análisis y conserva diagnósticos y anomalías." as diagnoses
component "Report Management / Core\n[Componente: ASP.NET Core / C#]\n\nConsolida diagnósticos y genera documentos." as reports
component "Agricultural Plot Management / Soporte\n[Componente: ASP.NET Core / C#]\n\nAdministra parcelas, cultivos y acceso colaborativo." as plots
component "Drone Management / Soporte\n[Componente: ASP.NET Core / C#]\n\nAdministra dispositivos, planes y ejecuciones de vuelo." as drones
component "Subscriptions and Payment Management / Soporte\n[Componente: ASP.NET Core / C#]\n\nAdministra vigencia y transacciones de suscripción." as subscriptions
component "Profiles and Preferences Management / Soporte\n[Componente: ASP.NET Core / C#]\n\nAdministra datos de contacto del usuario." as profiles
component "Notification Service / Genérico\n[Componente: ASP.NET Core / C#]\n\nRegistra avisos y coordina su entrega." as notifications
component "IAM — Identity and Access Management / Genérico\n[Componente: ASP.NET Core / C#]\n\nAdministra identidades, credenciales y autorización." as iam
component "Persistencia\n[Componente: Entity Framework Core]\n\nRepositorios por agregado y acceso a datos." as persistence
component "Integraciones externas\n[Componente: C# / HTTPS]\n\nAdaptadores de análisis, mapas, drones, pagos, mensajes y archivos." as integrations
}
database "Base de datos relacional\n[Contenedor: MySQL Server o PostgreSQL]" as db
component "Proveedores externos\n[Sistemas externos: Servicios / Dispositivos]\n\nAnálisis, mapas, drones, pagos, mensajería y almacenamiento." as providers
web --> diagnoses : REST [HTTPS / JSON]
diagnoses --> persistence : Consulta y persiste
diagnoses --> integrations : Solicita integración
web --> reports : REST [HTTPS / JSON]
reports --> persistence : Consulta y persiste
reports --> integrations : Solicita integración
web --> plots : REST [HTTPS / JSON]
plots --> persistence : Consulta y persiste
plots --> integrations : Solicita integración
web --> drones : REST [HTTPS / JSON]
drones --> persistence : Consulta y persiste
drones --> integrations : Solicita integración
web --> subscriptions : REST [HTTPS / JSON]
subscriptions --> persistence : Consulta y persiste
subscriptions --> integrations : Solicita integración
web --> profiles : REST [HTTPS / JSON]
profiles --> persistence : Consulta y persiste
web --> notifications : REST [HTTPS / JSON]
notifications --> persistence : Consulta y persiste
notifications --> integrations : Solicita integración
web --> iam : REST [HTTPS / JSON]
iam --> persistence : Consulta y persiste
persistence --> db : Lectura y escritura [SQL]
integrations --> providers : HTTPS / protocolo del dispositivo
legend bottom
C4 - Vista de componentes de la arquitectura propuesta.
Cada vista amplía un único contenedor.
Los contextos agrupan responsabilidades dentro del contenedor.
endlegend
@enduml
