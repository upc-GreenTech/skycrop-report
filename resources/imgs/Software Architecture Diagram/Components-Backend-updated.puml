@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Backend Component Overview
component "Frontend Web Application\n[Container: Vue]\n\nConsumes REST operations." as web
rectangle "Backend RESTful API\n[Container: C# / ASP.NET Core]" {
rectangle "Interfaces / Presentation" {
component "HTTP Controllers per Context\n[Component: ASP.NET Core]\n\nReceive requests and return HTTP resources." as controllers
}
rectangle "Application" {
component "Application Services per Context\n[Component: C#]\n\nCoordinate use cases through internal contracts." as application
component "Integration Contracts\n[Component: C# interfaces]\n\nDefine required provider and device operations." as integrationContracts
}
rectangle "Domain" {
component "Diagnoses Generation / Core\n[Component: C# domain model]\n\nRequests analysis and stores diagnoses and anomalies." as diagnoses
component "Report Management / Core\n[Component: C# domain model]\n\nConsolidates diagnoses and generates documents." as reports
component "Agricultural Plot Management / Supporting\n[Component: C# domain model]\n\nManages plots, crops and collaborative access." as plots
component "Drone Management / Supporting\n[Component: C# domain model]\n\nManages devices, flight plans and flight executions." as drones
component "Subscriptions and Payment Management / Supporting\n[Component: C# domain model]\n\nManages subscription validity and transactions." as subscriptions
component "Profiles and Preferences Management / Supporting\n[Component: C# domain model]\n\nManages user contact information." as profiles
component "Notification Service / Generic\n[Component: C# domain model]\n\nRecords notifications and coordinates delivery." as notifications
component "IAM — Identity and Access Management / Generic\n[Component: C# domain model]\n\nManages identities, credentials and authorization." as iam
component "Repository Contracts\n[Component: C# interfaces]\n\nDefine aggregate persistence." as repositoryContracts
}
rectangle "Infrastructure" {
component "Persistence\n[Component: Entity Framework Core]\n\nRepositories per aggregate and data access." as persistence
component "External Integrations\n[Component: C# / HTTPS]\n\nAdapters for analysis, maps, drones, payments, messaging and files." as integrations
}
}
database "Relational Database\n[Container: MySQL Server or PostgreSQL]" as db
component "External Providers\n[External systems: Services / Devices]\n\nAnalysis, maps, drones, payments, messaging and storage." as providers
web --> controllers : REST [HTTPS / JSON]
controllers --> application : Delegates use cases
application --> repositoryContracts : Queries and persists
application --> integrationContracts : Requests an operation
persistence ..|> repositoryContracts : Implements
integrations ..|> integrationContracts : Implements
application --> diagnoses : Applies rules
application --> reports : Applies rules
application --> plots : Applies rules
application --> drones : Applies rules
application --> subscriptions : Applies rules
application --> profiles : Applies rules
application --> notifications : Applies rules
application --> iam : Applies rules
persistence --> db : Reads and writes [SQL]
integrations --> providers : HTTPS / device protocol
diagnoses -[hidden]right-> reports
reports -[hidden]right-> plots
plots -[hidden]right-> drones
drones -[hidden]right-> subscriptions
subscriptions -[hidden]right-> profiles
profiles -[hidden]right-> notifications
notifications -[hidden]right-> iam
legend bottom
C4 - Component view of the proposed architecture.
Each view expands a single container.
The domain catalog follows the core, supporting and generic context order.
Each context distributes its components across the four layers.
Individual views detail the corresponding contracts and adapters.
endlegend
@enduml
