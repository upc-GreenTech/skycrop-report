@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam dpi 120
scale max 2800 width
hide empty members
top to bottom direction
title SkyCrop - Report Management - Layered Class Design
package "Interfaces / Presentation" {
class ReportController <<controller>> {
-service: IReportApplicationService
+generate(request: GenerateReportRequest): ReportResource
+getById(id: Long): ReportResource
}
class GenerateReportRequest <<request>> {
-plotId: Long
-diagnosisIds: List<Long>
}
class ReportResource <<resource>> {
-id: Long
}
class ReportResourceAssembler <<assembler>> {
+toResource(entity: Report): ReportResource
}
}
package "Application" {
class GenerateReportCommand <<command>> {
-plotId: Long
-diagnosisIds: List<Long>
}
interface IReportApplicationService {
+generate(command: GenerateReportCommand): ReportResource
+getById(id: Long): ReportResource
}
class ReportApplicationService <<application service>> {
-repository: IReportRepository
+generate(command: GenerateReportCommand): ReportResource
+getById(id: Long): ReportResource
}
}
package "Domain" {
class Report <<aggregate root>> {
-id: Long
-title: Name
-type: ReportType
+export(): void
}
interface IReportRepository <<repository contract>> {
+findById(id: Long): Report [0..1]
+save(entity: Report): void
}
}
package "Infrastructure" {
class ReportRepository <<repository>> {
-dbContext: SkyCropDbContext
+findById(id: Long): Report [0..1]
+save(entity: Report): void
}
class SkyCropDbContext <<EF Core>> {
+saveChanges(): int
}
}
ReportController --> IReportApplicationService : delegates
ReportController ..> GenerateReportRequest : receives
ReportController ..> GenerateReportCommand : builds
ReportController ..> ReportResource : responds
ReportApplicationService ..|> IReportApplicationService
IReportApplicationService ..> GenerateReportCommand : receives
ReportApplicationService --> IReportRepository : queries and persists
ReportApplicationService ..> Report : executes operations
ReportApplicationService ..> ReportResourceAssembler : transforms
ReportResourceAssembler ..> Report : reads
ReportResourceAssembler ..> ReportResource : produces
ReportRepository ..|> IReportRepository
IReportRepository ..> Report : persistence contract
ReportRepository --> SkyCropDbContext : data access
package "Application" {
interface IReportStorage <<integration contract>> {
+save(reportId: Long, content: String): ResourceUrl
}
}
package "Infrastructure" {
class CloudReportStorage <<adapter>> {
+save(reportId: Long, content: String): ResourceUrl
}
}
ReportApplicationService --> IReportStorage : requests an operation
CloudReportStorage ..|> IReportStorage
note bottom of CloudReportStorage
Stores the report file and returns its location.
end note
ReportController -[hidden]down-> ReportApplicationService
ReportApplicationService -[hidden]down-> Report
Report -[hidden]down-> ReportRepository
legend bottom
Proposed class architecture for the backend RESTful API.
The view shows a context use case and retrieval by identifier.
Aggregate attributes are detailed in the domain views.
Infrastructure dependencies implement internal contracts.
endlegend
package "Domain" {
class ResourceUrl <<value object>> {
-value: String {readOnly}
}
note right of ResourceUrl
Absolute HTTP or HTTPS URL with a host.
Equality uses the complete stored URL, including path and query.
A valid URL does not guarantee availability or access permission.
end note
class Name <<value object>> {
-value: String {readOnly}
}
note right of Name
Non-empty text after trimming outer whitespace.
Equality compares the resulting text; original case is preserved.
end note
}
Report "1" *-- "1" Name : title
@enduml
