@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam nodesep 35
skinparam ranksep 45
top to bottom direction
title SkyCrop - C4 - Frontend Component Overview
actor "Farmer / Agronomist\n[Person]" as user
rectangle "Frontend Web Application\n[Container: Vue / JavaScript / PrimeVue]" {
rectangle "Presentation" {
component "Layout and Navigation\n[Component: Vue]\n\nView navigation, language and interface states." as layout
component "Diagnoses Generation / Core\n[Component: Vue / JavaScript]\n\nDiagnoses, results map and history." as diagnoses
component "Report Management / Core\n[Component: Vue / JavaScript]\n\nReports, comparison and document downloads." as reports
component "Agricultural Plot Management / Supporting\n[Component: Vue / JavaScript]\n\nPlot registration, details, crops and collaboration." as plots
component "Drone Management / Supporting\n[Component: Vue / JavaScript]\n\nDrone registration, configuration and flights." as drones
component "Subscriptions and Payment Management / Supporting\n[Component: Vue / JavaScript]\n\nPlans, payments and subscription status." as subscriptions
component "Profiles and Preferences Management / Supporting\n[Component: Vue / JavaScript]\n\nProfile information viewing and editing." as profiles
component "Notification Service / Generic\n[Component: Vue / JavaScript]\n\nNotifications, details and read status." as notifications
component "IAM — Identity and Access Management / Generic\n[Component: Vue / JavaScript]\n\nRegistration, sign-in and account recovery." as iam
}
rectangle "Application" {
component "Stores per Context\n[Component: Pinia / JavaScript]\n\nCoordinate actions, loading state and errors." as stores
}
rectangle "Domain" {
component "Client Models per Context\n[Component: JavaScript]\n\nRepresent the data used by the interface." as models
}
rectangle "Infrastructure" {
component "API Clients and Assemblers\n[Component: JavaScript]\n\nSend remote requests and transform responses into models." as clients
component "HTTP Client\n[Component: JavaScript]\n\nREST requests and error handling." as http
}
}
component "Backend RESTful API\n[Container: C# / ASP.NET Core]\n\nDomain operations." as api
user --> layout : Interacts
layout --> diagnoses : Navigates
diagnoses --> stores : Requests context actions
layout --> reports : Navigates
reports --> stores : Requests context actions
layout --> plots : Navigates
plots --> stores : Requests context actions
layout --> drones : Navigates
drones --> stores : Requests context actions
layout --> subscriptions : Navigates
subscriptions --> stores : Requests context actions
layout --> profiles : Navigates
profiles --> stores : Requests context actions
layout --> notifications : Navigates
notifications --> stores : Requests context actions
layout --> iam : Navigates
iam --> stores : Requests context actions
stores --> clients : Invokes operations
stores --> models : Manages client data
clients --> models : Builds models
clients --> http : Sends requests
http --> api : REST [HTTPS / JSON]
diagnoses -[hidden]right-> reports
reports -[hidden]right-> plots
plots -[hidden]right-> drones
drones -[hidden]right-> subscriptions
subscriptions -[hidden]right-> profiles
profiles -[hidden]right-> notifications
notifications -[hidden]right-> iam
legend bottom
C4 - Component view of the proposed architecture.
Each view expands a single container.
Presentation modules follow the core, supporting and generic context order.
Stores, models and API clients are organized by context.
Client models do not replace the backend domain model.
endlegend
@enduml
